<Window x:Class="KsefPrinter.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="clr-namespace:KsefPrinter.Infrastructure"
    xmlns:vm="clr-namespace:KsefPrinter.ViewModels"
    Title="Ksef Printer" Width="640" Height="500"
    MinWidth="640" MinHeight="500" ResizeMode="CanResize"
    Topmost="True" WindowStyle="SingleBorderWindow">
    <Window.DataContext><vm:MainViewModel/></Window.DataContext>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock Text="{Binding LoadedStatus}" Width="120" TextAlignment="Center"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding ValidStatus}" Width="110" TextAlignment="Center"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding InvalidStatus}" Width="110" TextAlignment="Center"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding PrintedStatus}" Width="140" TextAlignment="Center"/></StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="5"><TabItem Header="Drukowanie"><Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="250"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="2"
                Margin="5" CornerRadius="10" AllowDrop="True"
                Background="Transparent"
                infra:FileDropCommandBehavior.DropCommand="{Binding DropFilesCommand}">
                <StackPanel VerticalAlignment="Center">
                    <Image Source="/Resources/pngegg.png" Stretch="Uniform"
                        Width="122" Height="122" HorizontalAlignment="Center"
                        Opacity="0.3" IsEnabled="False"/>
                    <TextBlock Text="Upuść tutaj fakturę XML do wydruku"
                        FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                        Margin="15" Foreground="#FF00A721" IsEnabled="False"/>
                </StackPanel>
            </Border>
            <ListBox Grid.Row="1" Margin="5" ItemsSource="{Binding LogItems}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Grid></TabItem><TabItem Header="Ustawienia"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="15" DataContext="{Binding Settings}"><TextBlock Text="Drukarka"/><ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"/><TextBlock Margin="0,12,0,0" Text="Nazwa pozycji"/><ComboBox ItemsSource="{Binding ItemNameDisplayModes}" SelectedItem="{Binding SelectedItemNameDisplay}"/><TextBlock Margin="0,12,0,0" Text="Ucinaj nazwę po liczbie znaków (5–500)"/><TextBox Text="{Binding ItemNameMaxLength, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Margin="0,12,0,0" Content="Pokazuj podgląd przed drukowaniem" IsChecked="{Binding ShowPrintPreview}"/><TextBlock Margin="0,12,0,0" Text="Preferowana cena"/><ComboBox ItemsSource="{Binding PreferredPriceModes}" SelectedItem="{Binding SelectedPreferredPrice}"/><TextBlock Margin="0,12,0,0" Text="Sprawdzanie aktualizacji"/><ComboBox ItemsSource="{Binding UpdateCheckOptions}" SelectedItem="{Binding SelectedUpdateCheck}"/><Button Margin="0,16,0,0" Content="Zapisz" Command="{Binding SaveCommand}" Width="120" HorizontalAlignment="Left"/></StackPanel></ScrollViewer></TabItem><TabItem><TabItem.Header><TextBlock Text="Aktualizacja" Foreground="{Binding Update.TabColor}"/></TabItem.Header><StackPanel Margin="15"><TextBlock Text="{Binding Update.UpdateStatus}" TextWrapping="Wrap"/><TextBlock Margin="0,12,0,4" Text="Co nowego:"/><TextBox Text="{Binding Update.ReleaseNotes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="220"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Sprawdź teraz" Command="{Binding Update.CheckCommand}" Padding="12,5"/><Button Content="Aktualizuj" Command="{Binding Update.InstallCommand}" IsEnabled="{Binding Update.HasUpdate}" Margin="10,0,0,0" Padding="12,5"/></StackPanel></StackPanel></TabItem></TabControl>
    </DockPanel>
</Window>