<Window
    x:Class="KsefPrinter.Views.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Podgląd faktury"
    Width="900"
    Height="1000"
    Background="DarkGray"
    WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F5F5F5" Padding="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PrintButton" Width="120" Height="34" Click="PrintButton_Click"
                        ToolTip="Drukuj na drukarce wybranej w ustawieniach">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe UI Symbol" FontSize="18" Text="🖨" Margin="0,0,8,0" />
                        <TextBlock Text="Drukuj" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <Grid>
        <FlowDocumentPageViewer
            x:Name="Viewer"
            Background="DarkGray"
            Zoom="100"
            MinZoom="25"
            MaxZoom="300"
            ZoomIncrement="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
    </Grid>
    </DockPanel>
</Window>
