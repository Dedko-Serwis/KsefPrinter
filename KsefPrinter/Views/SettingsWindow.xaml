<Window
    x:Class="KsefPrinter.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:KsefPrinter.ViewModels"
    Title="Ustawienia"
    Width="500"
    Height="395"
    WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:SettingsViewModel />
    </Window.DataContext>

    <StackPanel Margin="10">

        <TextBlock Margin="0,0,0,4" Text="Drukarka" />
        <ComboBox
            ItemsSource="{Binding Printers}"
            SelectedItem="{Binding SelectedPrinter}" />

        <TextBlock Margin="0,12,0,4" Text="Nazwa pozycji" />
        <ComboBox
            ItemsSource="{Binding ItemNameDisplayModes}"
            SelectedItem="{Binding SelectedItemNameDisplay}" />

        <TextBlock Margin="0,12,0,4" Text="Ucinaj nazwę po liczbie znaków (5–500)" />
        <TextBox Text="{Binding ItemNameMaxLength, UpdateSourceTrigger=PropertyChanged}" />

        <CheckBox Margin="0,12,0,0" Content="Pokazuj podgląd przed drukowaniem (wyłącz = drukuj od razu)"
                  IsChecked="{Binding ShowPrintPreview}" />

        <TextBlock Margin="0,12,0,4" Text="Preferowana cena (gdy XML zawiera netto i brutto)" />
        <ComboBox
            ItemsSource="{Binding PreferredPriceModes}"
            SelectedItem="{Binding SelectedPreferredPrice}" />

        <Button
            Margin="0,16,0,0"
            Content="Zapisz"
            Command="{Binding SaveCommand}" />

    </StackPanel>
</Window>
